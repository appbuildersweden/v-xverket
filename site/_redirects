# Den nedlagda Windows-appens gamla adresser. De svara 302 till startsidan i
# stället för att lämna kvar ett cachat uppdateringsmanifest.
/update.json / 302
/releases.json / 302
/downloads/* / 302
/elda.html / 302
/versioner.html / 302
/skola.html / 302

/skola /skola/ 308
/elev /skola/ 302
/elev/* /skola/ 302
/personal /skola/ 302
/personal/* /skola/ 302

# Skolappen använder hash-routing (#/elev/hem, #/larare/hem). Utan de här
# reglerna serveras hemsidans index.html på /skola/elev – den sidan laddar sina
# relativa filer från /skola/, får HTML tillbaka och blir ostylad, och
# skolappen syns inte alls. Direktadresserna skickas därför till appen.
/skola/elev /skola/#/elev/hem 302
/skola/elev/* /skola/#/elev/hem 302
/skola/personal /skola/#/larare/hem 302
/skola/personal/* /skola/#/larare/hem 302
