{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Elda",
  "version": "0.2.12",
  "identifier": "com.vaxverket.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm --prefix src-new run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Elda",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY3RUJCMEM4MDMzQ0U5NzQKUldSMDZUd0R5TERyWnp2a3dyNE9FMStmcUtvaDdsVWc5RGFueEg5NVI3ZzlDbVdZd2xXTVdxL20K",
      "endpoints": [
        "https://elda-6a9.pages.dev/update.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
